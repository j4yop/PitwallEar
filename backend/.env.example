HF_TOKEN=
LLM_PROVIDER=huggingface
OPENAI_API_KEY=

# ASR: speech -> text. Tiny runs on CPU; swap to `openai/whisper-small` or
# `openai/whisper-large-v3` for a stronger demo if you have a GPU.
ASR_MODEL=openai/whisper-tiny

# Speech-emotion model (SUPERB benchmark, 8 emotion labels).
EMOTION_MODEL=superb/wav2vec2-base-superb-er

# Text-emotion fallback (used for the /analyse-text and demo paths).
TEXT_EMOTION_MODEL=cardiffnlp/twitter-roberta-base-emotion

# Synthesis LLM. Leave as Hugging Face Inference API, or switch to openai.
LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
